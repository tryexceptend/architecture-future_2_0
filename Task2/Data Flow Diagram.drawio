        <mxCell id="JwWN1EWqEjxh59dG3Zjq-2" value="&lt;b&gt;Домен &quot;Клиника&quot;&lt;/b&gt;&lt;br&gt;&lt;div&gt;Работа с клиентами клиник, врачами, ресепшенов. Работает с данными пациентов&lt;/div&gt;" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;fontSize=11.7;fontColor=#000000;spacingLeft=8.4;spacingRight=8.4;spacingTop=2.4;spacing=3.6;strokeColor=#666666;strokeOpacity=100;fillOpacity=100;fillColor=#a5a7aa;strokeWidth=0.8;lucidId=elNyzAerL2sA;" parent="1" vertex="1">
